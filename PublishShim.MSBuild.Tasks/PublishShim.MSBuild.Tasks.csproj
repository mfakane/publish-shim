<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
	<TargetFramework>netstandard2.0</TargetFramework>
	<Nullable>enable</Nullable>
	<ImplicitUsings>enable</ImplicitUsings>
	<LangVersion>latest</LangVersion>
	<AssemblyName>PublishShim.MSBuild.Tasks</AssemblyName>
	<RootNamespace>PublishShim.MSBuild.Tasks</RootNamespace>
	<GeneratePackageOnBuild>false</GeneratePackageOnBuild>
	<CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
  </PropertyGroup>

  <ItemGroup>
	<PackageReference Include="Microsoft.Build.Framework" Version="18.10.1" PrivateAssets="all" />
	<PackageReference Include="Microsoft.Build.Utilities.Core" Version="18.10.1" PrivateAssets="all" />
  </ItemGroup>
</Project>
